        left_ankle_roll_link:
          Value: true
        left_elbow_link:
          Value: true
        left_hip_pitch_link:
          Value: true
        left_hip_roll_link:
          Value: true
        left_hip_yaw_link:
          Value: true
        left_knee_link:
          Value: true
        left_shoulder_pitch_link:
          Value: true
        left_shoulder_roll_link:
          Value: true
        left_shoulder_yaw_link:
          Value: true
        left_wrist_pitch_link:
          Value: true
        left_wrist_roll_link:
          Value: true
        left_wrist_yaw_link:
          Value: true
        lidar_chest_front:
          Value: true
        lidar_imu_chest_front:
          Value: true
        map:
          Value: true
        pelvis:
          Value: true
        rgb_head_center:
          Value: true
        rgb_head_rear:
          Value: true
        rgbd_head_front:
          Value: true
        right_ankle_pitch_link:
          Value: true
        right_ankle_roll_link:
          Value: true
        right_elbow_link:
          Value: true
        right_hip_pitch_link:
          Value: true
        right_hip_roll_link:
          Value: true
        right_hip_yaw_link:
          Value: true
        right_knee_link:
          Value: true
        right_shoulder_pitch_link:
          Value: true
        right_shoulder_roll_link:
          Value: true
        right_shoulder_yaw_link:
          Value: true
        right_wrist_pitch_link:
          Value: true
        right_wrist_roll_link:
          Value: true
        right_wrist_yaw_link:
          Value: true
        stereo_head_front:
          Value: true
        stereo_head_front_right:
          Value: true
        stereo_imu_head_front:
          Value: true
        torso_link:
          Value: true
        waist_pitch_link:
          Value: true
        waist_yaw_link:
          Value: true
      Marker Scale: 1
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Tree:
        base_link:
          pelvis:
            imu_in_pelvis_link:
              {}
            left_hip_pitch_link:
              left_hip_roll_link:
                left_hip_yaw_link:
                  left_knee_link:
                    left_ankle_pitch_link:
                      left_ankle_roll_link:
                        {}
            right_hip_pitch_link:
              right_hip_roll_link:
                right_hip_yaw_link:
                  right_knee_link:
                    right_ankle_pitch_link:
                      right_ankle_roll_link:
                        {}
            waist_yaw_link:
              waist_pitch_link:
                torso_link:
                  head_yaw_link:
                    head_pitch_link:
                      imu_in_head_link:
                        {}
                      rgb_head_center:
                        {}
                      rgb_head_rear:
                        {}
                      rgbd_head_front:
                        {}
                      stereo_head_front:
                        stereo_head_front_right:
                          {}
                        stereo_imu_head_front:
                          {}
                  imu_in_torso_link:
                    {}
                  left_shoulder_pitch_link:
                    left_shoulder_roll_link:
                      left_shoulder_yaw_link:
                        left_elbow_link:
                          left_wrist_yaw_link:
                            left_wrist_pitch_link:
                              left_wrist_roll_link:
